# Omit the partial generated Android tree so EAS runs Expo prebuild.
android/
.expo/

# Local screenshots/static exports from design iterations.
dist-android*/

# Local env and signing credential files never enter EAS archives.
.env*
credentials.json
credentials/
*.jks
*.keystore
*.pem

# Package-manager and OS noise.
node_modules/
.DS_Store
*.log
